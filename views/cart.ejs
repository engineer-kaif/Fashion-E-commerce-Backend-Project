<%- include('./partials/header') %>

    <div class="min-h-screen bg-gray-50 px-4 py-8 md:px-10 lg:px-16">

        <h1 class="text-3xl font-semibold mb-2">My Shopping Cart</h1>
        <p class="text-gray-500 mb-8">
            <%= user.cart.length %> products in your cart
        </p>

        <% if (user.cart.length===0) { %>

            <div class="bg-white rounded-xl p-10 text-center shadow-sm">
                <h2 class="text-xl font-semibold">Your cart is empty</h2>
                <p class="text-gray-500 mt-2">Add some products to continue shopping.</p>
                <a href="/shop" class="inline-block mt-5 bg-black text-white px-6 py-3 rounded-lg">
                    Continue Shopping
                </a>
            </div>

            <% } else { %>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">

                    <div class="lg:col-span-2 flex flex-col gap-4">

                        <% user.cart.forEach(function(item) { %>

                            <div class="bg-white rounded-xl border border-gray-200 p-4 flex gap-4 items-center">

                                <div class="w-24 h-24 sm:w-32 sm:h-32 shrink-0 rounded-lg flex items-center justify-center overflow-hidden"
                                    style="background-color: <%= item.bgcolor %>">

                                    <img class="max-w-full max-h-full object-contain"
                                        src="data:image/jpeg;base64,<%= item.image.toString('base64') %>"
                                        alt="<%= item.name %>" />
                                </div>

                                <div class="flex-1 min-w-0">

                                    <h2 class="text-base sm:text-lg font-semibold text-gray-800">
                                        <%= item.name %>
                                    </h2>

                                    <p class="text-sm text-gray-500 mt-1">
                                        Price: ₹<%= Number(item.price) %>
                                    </p>

                                    <p class="text-sm text-green-600 mt-1">
                                        Discount: ₹<%= Number(item.discount) %>
                                    </p>


                                    <div class="flex justify-between items-center gap-2 mt-3">

                                        <span class="text-base font-semibold">
                                            ₹<%= Number(item.price) - Number(item.discount) %>
                                        </span>

                                        <form action="/removefromcart/<%= item._id %>" method="POST">
                                            <button type="submit"
                                                class="text-sm text-red-600 hover:text-red-800 font-medium border border-red-200 hover:bg-red-50 px-3 py-1.5 rounded-lg">
                                                <i class="ri-delete-bin-line"></i>
                                                Remove
                                            </button>
                                        </form>

                                    </div>


                                </div>

                            </div>

                            <% }) %>

                    </div>
                    <div class="bg-white rounded-xl border border-gray-200 p-5 sm:p-6 lg:sticky lg:top-6">

                        <h2 class="text-xl font-semibold mb-5">Price Details</h2>

                        <div class="flex justify-between gap-3 text-sm mb-4">
                            <span class="text-gray-600">Total MRP</span>
                            <span>₹<%= user.cart.reduce((sum, item)=> sum + Number(item.price), 0) %></span>
                        </div>

                        <div class="flex justify-between gap-3 text-sm mb-4">
                            <span class="text-gray-600">Discount on MRP</span>
                            <span class="text-green-600">
                                - ₹<%= user.cart.reduce((sum, item)=> sum + Number(item.discount), 0) %>
                            </span>
                        </div>

                        <div class="flex justify-between gap-3 text-sm mb-4">
                            <span class="text-gray-600">Platform Fee</span>
                            <span>₹20</span>
                        </div>

                        <div class="flex justify-between gap-3 text-sm mb-5">
                            <span class="text-gray-600">Shipping Fee</span>
                            <span class="text-green-600">FREE</span>
                        </div>

                        <div class="border-t border-dashed border-gray-300 pt-4 flex justify-between gap-3">
                            <span class="font-semibold">Total Amount</span>
                            <span class="text-xl font-bold text-green-600">₹<%= bill %></span>
                        </div>

                        <button type="button"
                            class="w-full mt-6 bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-lg">
                            Continue to Checkout
                        </button>

                        <a href="/shop" class="block text-center text-sm text-gray-600 hover:text-black mt-4">
                            Continue Shopping
                        </a>

                    </div>

                </div>

                <% } %>

    </div>

    <%- include('./partials/footer') %>